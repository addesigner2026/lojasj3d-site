# ==============================================================================
# VARIÁVEIS DE AMBIENTE — LOJA SJ 3D (EXEMPLO SEM VALORES REAIS)
# ==============================================================================
# Copie para .env.local no desenvolvimento local (NUNCA faça commit de .env.local).
# Na Vercel, configure separadamente para Production, Preview e Development e
# marque SUPABASE_SERVICE_ROLE_KEY como Sensitive.

# URL do projeto Supabase (ex: https://seu-projeto.supabase.co)
SUPABASE_URL=

# Chave pública anon do Supabase (segura para o front-end; proteção real via RLS)
SUPABASE_ANON_KEY=

# Chave administrativa service_role do Supabase (SOMENTE SERVER-SIDE! NUNCA no front-end)
SUPABASE_SERVICE_ROLE_KEY=

# Ambiente de execução (production | preview | development)
NODE_ENV=development
